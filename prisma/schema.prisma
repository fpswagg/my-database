generator client {
  provider = "prisma-client-js"
  output   = "./."
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  partner
  client
}

model UserMetadata {
  uid       String   @id
  role      UserRole @default(client)
  data      Json     @default("{}")
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  name        Json
  description Json
  images      String[] @default([])
  link        String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(uuid())
  name        Json
  description Json
  images      String[] @default([])
  hasDemo     Boolean  @default(true)
  freeDemo    Boolean  @default(false)
  price       Int
  otherPrices Int[]    @default([])
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  uid       String
  comment   Json
  metadata  Json
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Scheduler {
  id           String @id
  detailedName String
  author       String @default("system:unkown")

  schedules Schedule[]
}

model Schedule {
  id           Int      @id @default(autoincrement())
  schedulerId  String
  creationTime DateTime @default(now())
  toPostAt     DateTime
  posted       Boolean  @default(false)
  webhook      String?
  content      String
  details      Json     @default("{}")

  scheduler Scheduler @relation(fields: [schedulerId], references: [id])
}

model Meal {
  id                       String       @id
  name                     String
  category                 String
  area                     String
  instructions             String
  thumbnail                String
  tags                     String[]
  youtube                  String
  ingredients              Ingredient[]
  source                   String
  imageSource              String?
  creativeCommonsConfirmed String?
  dateModified             DateTime?
}

model Ingredient {
  id         Int    @id @default(autoincrement())
  mealId     String @map("meal_id")
  meal       Meal   @relation(fields: [mealId], references: [id])
  ingredient String
  measure    String
}

model NumberPost {
  id             Int          @id @default(autoincrement())
  number_id      String
  number         NumberRecord @relation(fields: [number_id], references: [id], name: "NumberPosted")
  time           DateTime     @default(now())
  post_type      String
  destination_id String
  sender_id      String
  content        Json         @default("{}")
}

model NumberRecord {
  id                  String       @id
  source              String
  keywords            String[]
  saved_as            String?
  reason              String?
  discussionFrequency Int?
  posts               NumberPost[] @relation("NumberPosted")
}

model CodeBlueprint {
  id       Int    @id @default(autoincrement())
  code     String
  metadata Json   @default("{}")
}
